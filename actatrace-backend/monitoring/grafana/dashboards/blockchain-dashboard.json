{
  "title": "ActaTrace Blockchain Verification Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["actatrace", "blockchain"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Anchor Attempts",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(blockchain_anchor_attempts_total[5m])) by (provider, anchor_type)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Anchor Failures",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(blockchain_anchor_failures_total[5m])) by (provider, network)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Anchor Duration",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(blockchain_anchor_duration_seconds_bucket[5m])) by (le, provider, anchor_type))", "refId": "A"}]
    }
  ]
}

