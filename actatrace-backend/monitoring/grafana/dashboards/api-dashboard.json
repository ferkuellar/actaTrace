{
  "title": "ActaTrace Technical API Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["actatrace", "api"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate by Route",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (route, method)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP Errors",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_errors_total[5m])) by (route, status_code)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Rate Limited Requests",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_rate_limited_total[5m])) by (endpoint_group)", "refId": "A"}]
    }
  ]
}

